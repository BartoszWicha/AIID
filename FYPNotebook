        "def calculateSimilarityScore(text):\n",
        "    doc = nlp(text)\n",
        "    sentences = [sent.text.strip() for sent in doc.sents if sent.text.strip()]\n",
        "\n",
        "    if len(sentences) < 2:\n",
        "        return 0.0\n",
        "\n",
        "    embeddings = model.encode(sentences, convert_to_tensor=True)\n",
        "\n",
        "    similarities = []\n",
        "\n",
        "    for i in range(len(sentences) - 1):\n",
        "        similarity = util.cos_sim(embeddings[i], embeddings[i + 1]).item()\n",
        "        similarities.append(similarity)\n",
        "\n",
        "    return float(np.mean(similarities))\n",
        "\n",
        "def visualiseSimilarityScore(df):\n",
        "    plt.figure(figsize=(10,6))\n",
        "    sns.boxplot(\n",
        "        data=df,\n",
        "        x=\"group\",\n",
        "        y=\"similarityScore\",\n",
        "        palette=\"pastel\"\n",
        "    )\n",
        "\n",
        "    plt.title(\"Sentence Similarity Score Distribution\")\n",
        "    plt.xlabel(\"Text Source\")\n",
        "    plt.ylabel(\"Similarity Score\")\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "\n",
        "df['similarityScore'] = df['text'].apply(calculateSimilarityScore)"
      ],
