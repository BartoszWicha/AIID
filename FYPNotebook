        "import pandas as pd\n",
        "import numpy as np\n",
        "from collections import Counter\n",
        "from nltk.util import ngrams\n",
        "import spacy\n",
        "\n",
        "df = pd.read_excel('/content/drive/MyDrive/Dataset.xlsx')\n",
        "\n",
        "df['wordCount'] = df['text'].astype(str).apply(lambda x: len(x.split()))\n",
        "\n",
        "df = df[(df['wordCount'] >= 300) &\n",
        "                  (df['wordCount'] <= 400)].copy()\n",
        "\n",
        "dfHuman = df[(df['isHuman'] == 1) & (df['source'] == 'scientific research')].head(200)\n",
        "dfgpt4 = df[(df['isHuman'] == 0) & (df['source'] == 'gpt-3')].head(200)\n",
        "\n",
        "nlp = spacy.load(\"en_core_web_sm\")\n",
        "\n",
        "dfHuman['tokens'] = dfHuman['text'].apply(lambda x: nlp(x))\n",
        "dfgpt4['tokens'] = dfgpt4['text'].apply(lambda x: nlp(x))\n",
        "\n",
        "df = pd.concat([dfHuman, dfgpt4], ignore_index=True)\n",
        "\n",
        "#df.to_excel('./DatasetWithFeatures.xlsx', index=False)"
